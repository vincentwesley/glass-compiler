{
  "name": "glass-series",
  "version": "1.0.0",
  "private": true,
  "description": "The Glass series: computers you can see through. Glass Compiler, Glass Wasm and friends, with a shared debugger kit and one hub site.",
  "license": "MIT",
  "author": "Vin, Vin's Atelier (https://vwesley.dev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vincentwesley/glass-compiler.git"
  },
  "homepage": "https://vincentwesley.github.io/glass-compiler/series/",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/glass-ui",
    "packages/wasm-encode",
    "packages/compiler",
    "packages/wasm",
    "packages/small-c",
    "packages/hub"
  ],
  "scripts": {
    "dev": "npm run dev -w @glass/compiler",
    "build": "npm run build --workspaces --if-present && node scripts/assemble-site.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "check:site": "node scripts/check-site.mjs",
    "check:results": "node scripts/record-results.mjs compiler --check && node scripts/record-results.mjs wasm --check",
    "serve": "node scripts/serve-site.mjs",
    "acceptance": "npm run verify && npm run check:site && npm run check:results && npm run test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "playwright-core": "$@playwright/test"
  }
}
